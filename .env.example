# Copy to .env in this folder (hw4/) and fill in real values. NEVER commit .env.
#   cp .env.example .env
# backend/config.py looks for .env in backend/ and every parent folder (nearest wins).

# Required for the chatbot: Portkey gateway key (https://portkey.ai)
PORTKEY_API_KEY=your-portkey-api-key-here

# Required for login: secret used to sign login tokens. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-long-random-string

# ---- Optional overrides (defaults shown) ----
# Model routing (same setup as the course lectures)
# MODEL_NAME=gpt-6-luna
# PORTKEY_PROVIDER=@azure-openai-global
# PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Chat memory and per-message agent limits
# CHAT_HISTORY_LIMIT=20
# AGENT_REQUEST_LIMIT=8
# AGENT_TOOL_CALLS_LIMIT=10
# AGENT_TOTAL_TOKENS_LIMIT=150000

# Password hashing cost (PBKDF2-SHA256 iterations)
# PBKDF2_ITERATIONS=600000

# File locations (defaults: data/campus_customs.db and output/audit_trail.json)
# DB_PATH=
# AUDIT_PATH=
